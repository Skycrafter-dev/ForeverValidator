// Search specialization translated from cuda_exact_math.cuh.



namespace forevervalidator::simulation::cuda::exact {
namespace detail {

inline double Pi() { return double_from_bits(0x400921fb54442d18ull); }
inline double HalfPi() { return double_from_bits(0x3ff921fb54442d18ull); }
inline double QuarterPi() { return double_from_bits(0x3fe921fb54442d18ull); }
inline double TwoOverPi() { return double_from_bits(0x3fe45f306dc9c883ull); }
inline double HalfPiHigh() { return double_from_bits(0x3ff921fb54400000ull); }
inline double HalfPiLow() { return double_from_bits(0x3dd0b4611a626331ull); }
inline double Log2E() { return double_from_bits(0x3ff71547652b82feull); }
inline double Ln2High() { return double_from_bits(0x3fe62e42fefa39efull); }
inline double Ln2Low() { return double_from_bits(0x3c7abc9e3b39803full); }

 inline float QuietNaN(bool negative = false) {
    return asfloat((negative ? 0x80000000u : 0u) | 0x7fc00000u);
}

 inline double PowerOfTwo(int exponent) {
    if (exponent < -1022) {
        return 0.0;
    }
    if (exponent > 1023) {
        return double_from_bits(0x7ff0000000000000ull);
    }
    return ldexp(1.0, exponent);
}

 inline double AtanUnit(double value) {
    const bool aroundOne = value > double_from_bits(0x3fda827999fcef32ull);
    const double reduced =
            aroundOne ? (value - 1.0) / (value + 1.0) : value;
    const double square = reduced * reduced;
    double power = reduced;
    double result = reduced;
    for (uint termIndex = 1u; termIndex <= 24u; ++termIndex) {
        power *= -square;
        result += power / double(termIndex * 2u + 1u);
    }
    return aroundOne ? QuarterPi() + result : result;
}

 inline double Atan2(double y, double x) {
    const bool yNegative = signbit_portable(y);
    const bool xNegative = signbit_portable(x);
    const double absY = abs(y);
    const double absX = abs(x);
    if (absY == 0.0) {
        if (xNegative) {
            return yNegative ? -Pi() : Pi();
        }
        return y;
    }
    if (absX == 0.0) {
        return yNegative ? -HalfPi() : HalfPi();
    }
    double angle = absY <= absX
            ? AtanUnit(absY / absX)
            : HalfPi() - AtanUnit(absX / absY);
    if (xNegative) {
        angle = Pi() - angle;
    }
    return yNegative ? -angle : angle;
}

struct AtanApproximation {
    double value;
    double error;
};

 inline AtanApproximation AtanUnitApproximation(
        double value) {
    const bool aroundOne = value > double_from_bits(0x3fda827999fcef32ull);
    const double reduced =
            aroundOne ? (value - 1.0) / (value + 1.0) : value;
    const double square = reduced * reduced;
    double power = reduced;
    double result = reduced;
    for (uint termIndex = 1u; termIndex <= 8u; ++termIndex) {
        power *= -square;
        result += power / double(termIndex * 2u + 1u);
    }
    const double firstOmitted = power * -square;
    const double tailBound =
            abs(firstOmitted) /
            (19.0 * (1.0 - square));
    return {
            aroundOne ? QuarterPi() + result : result,
            tailBound + double_from_bits(0x3d16849b86a12b9bull),
    };
}

 inline AtanApproximation Atan2Approximation(
        double y, double x) {
    const bool yNegative = signbit_portable(y);
    const bool xNegative = signbit_portable(x);
    const double absY = abs(y);
    const double absX = abs(x);
    AtanApproximation result =
            absY <= absX
            ? AtanUnitApproximation(absY / absX)
            : AtanUnitApproximation(absX / absY);
    if (absY > absX) {
        result.value = HalfPi() - result.value;
    }
    if (xNegative) {
        result.value = Pi() - result.value;
    }
    if (yNegative) {
        result.value = -result.value;
    }
    return result;
}

 inline bool CertifiedFloatRound(
        __constref AtanApproximation approximation,
        float *result) {
    const float rounded = float(
            approximation.value);
    const float previous = nextafter_portable(
            rounded,
            -asfloat(0x7f800000u));
    const float next = nextafter_portable(
            rounded,
            asfloat(0x7f800000u));
    const double lower =
            (double(previous) +
             double(rounded)) *
            0.5;
    const double upper =
            (double(rounded) +
             double(next)) *
            0.5;
    if (approximation.value - approximation.error <= lower ||
        approximation.value + approximation.error >= upper) {
        return false;
    }
    *result = rounded;
    return true;
}

 inline double SinPolynomial(double value) {
    const double square = value * value;
    double coefficient = double_from_bits(0xbc62f49b46814157ull);
    coefficient = double_from_bits(0x3ce952c77030ad4aull) + square * coefficient;
    coefficient = double_from_bits(0xbd6ae7f3e733b81full) + square * coefficient;
    coefficient = double_from_bits(0x3de6124613a86d09ull) + square * coefficient;
    coefficient = double_from_bits(0xbe5ae64567f544e4ull) + square * coefficient;
    coefficient = double_from_bits(0x3ec71de3a556c734ull) + square * coefficient;
    coefficient = double_from_bits(0xbf2a01a01a01a01aull) + square * coefficient;
    coefficient = double_from_bits(0x3f81111111111111ull) + square * coefficient;
    coefficient = double_from_bits(0xbfc5555555555555ull) + square * coefficient;
    return value + value * square * coefficient;
}

 inline double CosPolynomial(double value) {
    const double square = value * value;
    double coefficient = double_from_bits(0xbca6827863b97d97ull);
    coefficient = double_from_bits(0x3d2ae7f3e733b81full) + square * coefficient;
    coefficient = double_from_bits(0xbda93974a8c07c9dull) + square * coefficient;
    coefficient = double_from_bits(0x3e21eed8eff8d898ull) + square * coefficient;
    coefficient = double_from_bits(0xbe927e4fb7789f5cull) + square * coefficient;
    coefficient = double_from_bits(0x3efa01a01a01a01aull) + square * coefficient;
    coefficient = double_from_bits(0xbf56c16c16c16c17ull) + square * coefficient;
    coefficient = double_from_bits(0x3fa5555555555555ull) + square * coefficient;
    coefficient = -0.5 + square * coefficient;
    return 1.0 + square * coefficient;
}

struct ReducedAngle {
    double value;
    uint quadrant;
};

struct FixedProduct {
    uint64_t limbs[4];
};

 inline FixedProduct MultiplyTwoOverPi(
        uint significand) {
    static const uint64_t fixed[3] = {
            0xdb6295993c439041ull,
            0xfc2757d1f534ddc0ull,
            0xa2f9836e4e441529ull,
    };
    FixedProduct result = FixedProduct();
    uint64_t carry = 0u;
    for (uint index = 0u; index < 3u; ++index) {
        const uint64_t limb = fixed[index];
        const uint64_t low =
                uint64_t(
                        uint(limb)) *
                        significand +
                carry;
        const uint64_t high =
                uint64_t(
                        uint(limb >> 32u)) *
                        significand +
                (low >> 32u);
        result.limbs[index] =
                (low & 0xffffffffu) | (high << 32u);
        carry = high >> 32u;
    }
    result.limbs[3] = carry;
    return result;
}

 inline bool FixedBit(__constref FixedProduct value,
                                uint bitIndex) {
    return bitIndex < 256u &&
           ((value.limbs[bitIndex / 64u] >>
             (bitIndex % 64u)) &
            1u) != 0u;
}

 inline bool AnyFixedBitsBelow(
        __constref FixedProduct value,
        uint bitCount) {
    const uint fullLimbs = bitCount / 64u;
    for (uint index = 0u;
         index < fullLimbs && index < 4u;
         ++index) {
        if (value.limbs[index] != 0u) {
            return true;
        }
    }
    const uint remaining = bitCount % 64u;
    return fullLimbs < 4u && remaining != 0u &&
           (value.limbs[fullLimbs] &
            ((uint64_t(1) << remaining) - 1u)) != 0u;
}

 inline ReducedAngle ReduceLargeAngle(float input) {
    int binaryExponent = 0;
    const float mantissa = frexp(abs(input), binaryExponent);
    const int exponent = binaryExponent - 1;
    const uint significand =
            uint(
                    ldexp(double(mantissa), 24));
    const FixedProduct product = MultiplyTwoOverPi(significand);
    const uint binaryPoint =
            uint(215 - exponent);
    uint nearest =
            (FixedBit(product, binaryPoint) ? 1u : 0u) |
            (FixedBit(product, binaryPoint + 1u) ? 2u : 0u);
    const bool halfway = FixedBit(product, binaryPoint - 1u);
    const bool below = AnyFixedBitsBelow(product, binaryPoint - 1u);
    const bool roundUp = halfway && (below || (nearest & 1u) != 0u);
    if (roundUp) {
        nearest = (nearest + 1u) & 3u;
    }
    double fraction = 0.0;
    double weight = 0.5;
    for (uint offset = 1u; offset <= 64u; ++offset) {
        if (FixedBit(product, binaryPoint - offset)) {
            fraction += weight;
        }
        weight *= 0.5;
    }
    if (roundUp) {
        fraction -= 1.0;
    }
    if (signbit_portable(input)) {
        fraction = -fraction;
        nearest = (0u - nearest) & 3u;
    }
    return {fraction * HalfPi(), nearest};
}

 inline ReducedAngle ReduceAngle(float input) {
    if (abs(input) > 1000000.0f) {
        return ReduceLargeAngle(input);
    }
    const double value = double(input);
    const double scaled = value * TwoOverPi();
    const int64_t nearest = scaled >= 0.0
            ? int64_t(scaled + 0.5)
            : int64_t(scaled - 0.5);
    const double count = double(nearest);
    return {
            (value - count * HalfPiHigh()) - count * HalfPiLow(),
            uint(nearest) & 3u,
    };
}

}  // namespace detail

 inline float FromDouble(double value) {
    if (isnan(value)) {
        return detail::QuietNaN(signbit_portable(value));
    }
    return float(value);
}

 inline float FromUnsignedInteger(uint value) {
    return float(value);
}

 inline float Divide(float numerator, float denominator) {
    return FromDouble(double(numerator) / double(denominator));
}

 inline uint TruncateToUint32Modulo(float value) {
    if (!isfinite_portable(value) ||
        abs(value) >= 18446744073709551616.0) {
        return 0u;
    }
    const double truncated = trunc(double(value));
    const double wrapped = fmod(abs(truncated), 4294967296.0);
    const uint magnitude =
            uint(wrapped);
    return signbit_portable(value) ? 0u - magnitude : magnitude;
}

 inline float Sqrt(float value) {
    if (value >= 0.0f) {
        return FromDouble(sqrt(double(value)));
    }
    return FromDouble(sqrt(double(value)));
}

 inline float Atan2(float y, float x) {
    if (isnan(x) || isnan(y)) {
        return detail::QuietNaN();
    }
    if (y != 0.0f && x != 0.0f &&
        isfinite_portable(y) && isfinite_portable(x)) {
        const detail::AtanApproximation approximation =
                detail::Atan2Approximation(
                        double(y),
                        double(x));
        float result = 0.0f;
        if (detail::CertifiedFloatRound(
                    approximation, &result)) {
            return result;
        }
    }
    return FromDouble(detail::Atan2(
            double(y), double(x)));
}

 inline float Acos(float value) {
    if (isnan(value) || value < -1.0f || value > 1.0f) {
        return detail::QuietNaN();
    }
    const float positive = 1.0f + value;
    const float negative = 1.0f - value;
    return Atan2(Sqrt(positive * negative), value);
}

 inline float Asin(float value) {
    if (isnan(value) || value < -1.0f || value > 1.0f) {
        return detail::QuietNaN();
    }
    const float positive = 1.0f + value;
    const float negative = 1.0f - value;
    return Atan2(value, Sqrt(positive * negative));
}

 inline float Sin(float value) {
    if (!isfinite_portable(value)) {
        return detail::QuietNaN();
    }
    const detail::ReducedAngle reduced = detail::ReduceAngle(value);
    double result = 0.0;
    switch (reduced.quadrant) {
    case 0u: result = detail::SinPolynomial(reduced.value); break;
    case 1u: result = detail::CosPolynomial(reduced.value); break;
    case 2u: result = -detail::SinPolynomial(reduced.value); break;
    default: result = -detail::CosPolynomial(reduced.value); break;
    }
    return FromDouble(result);
}

 inline float Cos(float value) {
    if (!isfinite_portable(value)) {
        return detail::QuietNaN();
    }
    const detail::ReducedAngle reduced = detail::ReduceAngle(value);
    double result = 0.0;
    switch (reduced.quadrant) {
    case 0u: result = detail::CosPolynomial(reduced.value); break;
    case 1u: result = -detail::SinPolynomial(reduced.value); break;
    case 2u: result = -detail::CosPolynomial(reduced.value); break;
    default: result = detail::SinPolynomial(reduced.value); break;
    }
    return FromDouble(result);
}

struct SinCosResult {
    float sine;
    float cosine;
};

 inline SinCosResult SinCos(float value) {
    if (!isfinite_portable(value)) {
        const float nan = detail::QuietNaN();
        return {nan, nan};
    }
    const detail::ReducedAngle reduced = detail::ReduceAngle(value);
    double sine = 0.0;
    double cosine = 0.0;
    switch (reduced.quadrant) {
    case 0u:
        sine = detail::SinPolynomial(reduced.value);
        cosine = detail::CosPolynomial(reduced.value);
        break;
    case 1u:
        sine = detail::CosPolynomial(reduced.value);
        cosine = -detail::SinPolynomial(reduced.value);
        break;
    case 2u:
        sine = -detail::SinPolynomial(reduced.value);
        cosine = -detail::CosPolynomial(reduced.value);
        break;
    default:
        sine = -detail::CosPolynomial(reduced.value);
        cosine = detail::SinPolynomial(reduced.value);
        break;
    }
    return {FromDouble(sine), FromDouble(cosine)};
}

 inline float Tan(float value) {
    if (!isfinite_portable(value)) {
        return detail::QuietNaN();
    }
    const detail::ReducedAngle reduced = detail::ReduceAngle(value);
    const double sine = detail::SinPolynomial(reduced.value);
    const double cosine = detail::CosPolynomial(reduced.value);
    return FromDouble((reduced.quadrant & 1u) == 0u
            ? sine / cosine
            : -cosine / sine);
}

 inline float Exp(float value) {
    if (isnan(value)) {
        return value;
    }
    if (value > 89.0f) {
        return asfloat(0x7f800000u);
    }
    if (value < -110.0f) {
        return 0.0f;
    }
    const double input = double(value);
    const double scaled = input * detail::Log2E();
    const int exponent = scaled >= 0.0
            ? int(scaled + 0.5)
            : int(scaled - 0.5);
    const double reduced =
            (input - double(exponent) * detail::Ln2High()) -
            double(exponent) * detail::Ln2Low();
    double tail = double_from_bits(0x3ce952c77030ad4aull);
    tail = double_from_bits(0x3d2ae7f3e733b81full) + reduced * tail;
    tail = double_from_bits(0x3d6ae7f3e733b81full) + reduced * tail;
    tail = double_from_bits(0x3da93974a8c07c9dull) + reduced * tail;
    tail = double_from_bits(0x3de6124613a86d09ull) + reduced * tail;
    tail = double_from_bits(0x3e21eed8eff8d898ull) + reduced * tail;
    tail = double_from_bits(0x3e5ae64567f544e4ull) + reduced * tail;
    tail = double_from_bits(0x3e927e4fb7789f5cull) + reduced * tail;
    tail = double_from_bits(0x3ec71de3a556c734ull) + reduced * tail;
    tail = double_from_bits(0x3efa01a01a01a01aull) + reduced * tail;
    tail = double_from_bits(0x3f2a01a01a01a01aull) + reduced * tail;
    tail = double_from_bits(0x3f56c16c16c16c17ull) + reduced * tail;
    tail = double_from_bits(0x3f81111111111111ull) + reduced * tail;
    tail = double_from_bits(0x3fa5555555555555ull) + reduced * tail;
    tail = double_from_bits(0x3fc5555555555555ull) + reduced * tail;
    tail = 0.5 + reduced * tail;
    const double polynomial =
            1.0 + reduced * (1.0 + reduced * tail);
    return FromDouble(polynomial * detail::PowerOfTwo(exponent));
}

 inline float Fmod(float value, float modulus) {
    return fmod(value, modulus);
}

}  // namespace forevervalidator::simulation::cuda::exact



// Search specialization translated from cuda_memory.cuh.



namespace forevervalidator::simulation::cuda::memory {

inline void CopyBytes<let Count : uint64_t, Destination, Source>(Destination *destination,
                                 Source *source) {
    
    
    uint8_t *destinationBytes =
            reinterpret<uint8_t *>(destination);
    uint8_t *sourceBytes =
            reinterpret<uint8_t *>(source);
#pragma unroll
    for (uint64_t index = 0u; index < Count; ++index) {
        destinationBytes[index] = sourceBytes[index];
    }
}

}  // namespace forevervalidator::simulation::cuda::memory



// Search specialization translated from cuda_tuning.cuh.



namespace forevervalidator::simulation::cuda::tuning {

inline T *Section<T>(
        CudaPackedStaticConfigurationHeader *configuration,
        __constref CudaStaticConfigurationSection section) {
#if defined(FOREVERVALIDATOR_CUDA_RESEARCH_SESSION_LTO)
    if (is_same_v<T, CudaTuningCurveKey>) {
        return reinterpret<T *>(
                research::ForeverValidatorSessionCurveKeyBytes());
    }
#endif
#if defined(FOREVERVALIDATOR_CUDA_RESEARCH_CONSTANT_CURVE_KEYS)
    if (is_same_v<T, CudaTuningCurveKey>) {
        return research::StaticCurveKeys;
    }
#endif
#if defined(FOREVERVALIDATOR_CUDA_RESEARCH_SESSION_LTO)
    let *base =
            reinterpret<uint8_t *>(
                    research::SessionConfigurationBase());
#elif defined(FOREVERVALIDATOR_CUDA_RESEARCH_CONSTANT_CONFIGURATION)
    let *base =
            reinterpret<uint8_t *>(
                    research::StaticConfigurationBase);
#else
    uint8_t *base =
            reinterpret<uint8_t *>(configuration);
#endif
    return reinterpret<T *>(base + section.offset);
}

 inline float Evaluate(
        CudaPackedStaticConfigurationHeader *configuration,
        uint id,
        float input,
        bool forceConstant = false) {
    CudaTuningCurve *curves =
            reinterpret<CudaTuningCurve *>(
                    &configuration->tuning.curves);
    CudaTuningCurve curve =
            curves[uint(id)];
    if (curve.keyCount == 0u) {
        return 0.0f;
    }
    CudaTuningCurveKey *allKeys =
            Section<CudaTuningCurveKey>(
                    configuration, configuration->curveKeys);
    CudaTuningCurveKey *keys = allKeys + curve.firstKey;
    if (curve.keyCount == 1u) {
        return keys[0].value;
    }
    static const float KeyEpsilon = 1.0e-5f;
    // One operation on two binary32 values is exact in binary64 before the
    // final binary32 rounding, so this preserves the former wide result.
    uint keyIndex = 0u;
    uint nextKeyIndex = 0u;
    if (input < (keys[0].position - KeyEpsilon)) {
        keyIndex = 0u;
        nextKeyIndex = 0u;
    } else if (input >
               (keys[curve.keyCount - 1u].position + KeyEpsilon)) {
        keyIndex = curve.keyCount - 1u;
        nextKeyIndex = keyIndex;
    } else if ((curve.reserved &
                CudaTuningCurvePositionsNondecreasing) != 0u &&
               !isnan(input)) {
        uint first = 1u;
        uint last = curve.keyCount;
        while (first < last) {
            const uint middle =
                    first + (last - first) / 2u;
            if (input <=
                (keys[middle].position + KeyEpsilon)) {
                last = middle;
            } else {
                first = middle + 1u;
            }
        }
        keyIndex = first - 1u;
        nextKeyIndex = first;
    } else {
        uint current = 0u;
        for (uint scanned = 0u;
             scanned <= curve.keyCount; ++scanned) {
            const uint next =
                    current + 1u < curve.keyCount
                    ? current + 1u
                    : 0u;
            const float lower =
                    (keys[current].position - KeyEpsilon);
            const float upper =
                    (keys[next].position + KeyEpsilon);
            if (!isnan(input) && !isnan(lower) &&
                !isnan(upper) && input >= lower &&
                input <= upper) {
                keyIndex = current;
                nextKeyIndex = next;
                break;
            }
            current = next;
            if (scanned == curve.keyCount) {
                keyIndex = current;
                nextKeyIndex =
                        current + 1u < curve.keyCount
                        ? current + 1u
                        : 0u;
            }
        }
    }
    float blend = 0.0f;
    if (keyIndex != nextKeyIndex) {
        const float firstPosition = keys[keyIndex].position;
        const float span =
                keys[nextKeyIndex].position - firstPosition;
        blend = abs(span) >= KeyEpsilon
                ? forevervalidator::simulation::cuda::exact::Divide(input - firstPosition, span)
                : 0.0f;
    }
    if (keyIndex == nextKeyIndex || forceConstant ||
        curve.interpolation ==
                uint(
                        ReplayTuningCurveInterpolation_Constant)) {
        return keys[keyIndex].value;
    }
    const float firstValue = keys[keyIndex].value;
    const float nextValue = keys[nextKeyIndex].value;
    return (1.0f - blend) * firstValue +
           blend * nextValue;
}

 inline float SpeedInput(float speed) {
    return speed * 3.6f;
}

 inline float EvaluateSpeed(
        CudaPackedStaticConfigurationHeader *configuration,
        uint id,
        float speed,
        bool forceConstant = false) {
    return Evaluate(
            configuration, id, SpeedInput(speed),
            forceConstant);
}

 inline float *TransmissionValues(
        CudaPackedStaticConfigurationHeader *configuration,
        uint id,
        inout uint count) {
    CudaTransmissionArray *arrays =
            reinterpret<CudaTransmissionArray *>(
                    &configuration->tuning.gearedDrive.
                            transmissionArrays);
    CudaTransmissionArray array =
            arrays[uint(id)];
    count = array.valueCount;
    return Section<float>(
                   configuration,
                   configuration->transmissionValues) +
           array.firstValue;
}

}  // namespace forevervalidator::simulation::cuda::tuning



